{
   "$schema": "https://opencode.ai/tui.json",
   "theme": "tokyonight",
   "leader_timeout": 1500,
   "mouse": true,
   "scroll_speed": 3,
   "scroll_acceleration": {
      "enabled": true
   },
   "diff_style": "auto",
   "attention": {
      "enabled": true,
      "notifications": true,
      "sound": true,
      "volume": 0.35
   },
   "keybinds": {
      "leader": "ctrl+x",
      "command_list": "ctrl+p",
   }
}